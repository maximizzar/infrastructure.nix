$ORIGIN @DOMAIN@.
$TTL 300

@                       IN SOA ns-primary.@DOMAIN@. admin.@DOMAIN@. (
                            @SERIAL@
                            @REFRESH@ @RETRY@ @EXPIRE@ @MINIMUM@ )

@                       IN  AAAA    fe80::1
*                       IN  CNAME   @

@                       IN  NS      ns-primary.@DOMAIN@.
@                       IN  NS      ns-secondary.@DOMAIN@.

ns-primary              IN  AAAA    fd80:3aa8:691a:20:be24:11ff:fee8:c513
ns-secondary            IN  AAAA    fd80:3aa8:691a:20:be24:11ff:fed9:139f

; core
gateway.core.prod                   IN  AAAA    fd19:38bc:a21d:1abf:be24:11ff:fed0:6f4d
ns-primary.core.prod                IN  AAAA    fd80:3aa8:691a:20:be24:11ff:fec9:4372
ns-secondary.core.prod              IN  AAAA    fd80:3aa8:691a:20:be24:11ff:fe3b:7814
prometheus.core.prod                IN  AAAA    fd80:3aa8:691a:20:be24:11ff:feff:cafb
root.ca.core.prod                   IN  AAAA    fd80:3aa8:691a:20:be24:11ff:fe6c:5622
root.ca                             IN  CNAME   root.ca.core.prod

; game

k2se.game.prod                      IN  AAAA    fe80::1

; vc
forgejo.vc.prod                     IN  AAAA    fd80:3aa8:691a:30:be24:11ff:fe1c:868
woodpecker.vc.prod                  IN  AAAA    fe80::1

; web
home-assistant.web.prod             IN  AAAA    fe80::1
immich.web.prod                     IN  AAAA    fe80::1
jellyfin.web.prod                   IN  AAAA    fe80::1
notes.web.prod                      IN  AAAA    fe80::1
tubearchivist.web.prod              IN  AAAA    fe80::1


; metrics subdomains for prometheus node exporter

metrics.ns-primary                  IN  CNAME   ns-primary
metrics.ns-secondary                IN  CNAME   ns-secondary
metrics.gateway.core.prod           IN  CNAME   gateway.core.prod
metrics.ns-primary.core.prod        IN  CNAME   ns-primary.core.prod
metrics.ns-secondary.core.prod      IN  CNAME   ns-secondary.core.prod

metrics.k2se.game.prod              IN  CNAME   k2se.game.prod
